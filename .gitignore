# Dependencies
node_modules/
.npm/

# Package manager lockfiles
# Keep npm's lockfile versioned for reproducible local development.
# Ignore alternate package-manager lockfiles for this repo.
yarn.lock
pnpm-lock.yaml
bun.lock
bun.lockb

# TypeScript / build output
*.tsbuildinfo
dist/
build/
out/

# Logs
*.log

# Environment / secrets — never commit real .env files
.env
.env.*
!.env.example

# OS cruft
.DS_Store
Thumbs.db
desktop.ini

# Editor / IDE
.idea/
*.swp
*.swo
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Caches
.cache/
.tmp/
tmp/
